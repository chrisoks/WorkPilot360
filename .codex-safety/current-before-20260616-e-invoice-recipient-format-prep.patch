+.modal,
+.workloadCell,
+.workloadUser,
+.calendarDay,
+.absencePanel {
+  -webkit-font-smoothing: antialiased;
+}
+
+.tabs {
+  background: rgba(239, 246, 255, 0.68);
+  border: 1px solid rgba(191, 219, 254, 0.58);
+  border-radius: 22px;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.82);
+  gap: 8px;
+  margin-left: auto;
+  margin-right: auto;
+  padding: 8px;
+  width: fit-content;
+}
+
+.tab {
+  background: transparent;
+  border-color: transparent;
+  border-radius: 16px;
+  box-shadow: none;
+  color: #1d4ed8;
+  font-weight: 850;
+  padding: 11px 22px;
+}
+
+.tab:hover {
+  background: rgba(255, 255, 255, 0.72);
+  border-color: rgba(191, 219, 254, 0.74);
+}
+
+.activeTab {
+  background: linear-gradient(180deg, #2f75ff 0%, #1d4ed8 100%);
+  border-color: rgba(255, 255, 255, 0.28);
+  color: #ffffff;
+  box-shadow:
+    0 10px 24px rgba(29, 78, 216, 0.28),
+    inset 0 1px 0 rgba(255, 255, 255, 0.34);
+}
+
+.tab.activeTab {
+  background: linear-gradient(180deg, #2f75ff 0%, #1d4ed8 100%);
+  border-color: rgba(255, 255, 255, 0.28);
+  color: #ffffff;
+  box-shadow:
+    0 10px 24px rgba(29, 78, 216, 0.28),
+    inset 0 1px 0 rgba(255, 255, 255, 0.34);
+}
+
+.tab.activeTab:hover {
+  background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
+  border-color: rgba(255, 255, 255, 0.34);
+  color: #ffffff;
+}
+
+.primaryButton {
+  background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%);
+  border: 1px solid rgba(255, 255, 255, 0.28);
+  border-radius: 16px;
+  box-shadow:
+    0 14px 30px rgba(37, 99, 235, 0.24),
+    inset 0 1px 0 rgba(255, 255, 255, 0.32);
+}
+
+.primaryButton:hover {
+  box-shadow:
+    0 18px 38px rgba(37, 99, 235, 0.28),
+    inset 0 1px 0 rgba(255, 255, 255, 0.36);
+}
+
+.requestButton {
+  background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%);
+  border: 1px solid rgba(255, 255, 255, 0.36);
+  border-radius: 16px;
+  box-shadow:
+    0 14px 30px rgba(245, 158, 11, 0.24),
+    inset 0 1px 0 rgba(255, 255, 255, 0.38);
+  color: #7c2d12;
+  cursor: pointer;
+  font: inherit;
+  font-weight: 950;
+  padding: 14px 22px;
+  transition: 0.2s ease;
+}
+
+.requestButton:hover {
+  box-shadow:
+    0 18px 38px rgba(245, 158, 11, 0.28),
+    inset 0 1px 0 rgba(255, 255, 255, 0.42);
+  transform: translateY(-2px);
+}
+
+.secondaryButton,
+.deleteButton,
+.acceptButton {
+  border-radius: 14px;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.76);
+}
+
+.secondaryButton {
+  background: rgba(255, 255, 255, 0.88);
+  border-color: rgba(148, 163, 184, 0.38);
+}
+
+.secondaryButton:hover {
+  background: #f8fbff;
+  border-color: #93c5fd;
+  color: #1d4ed8;
+}
+
+.card,
+.tableCard,
+.kanbanColumn,
+.settingsCard,
+.reportHero,
+.reportPanel,
+.heroDetailCard,
+.absencePanel {
+  background: var(--surface-strong);
+  border-color: var(--line);
+  box-shadow:
+    var(--shadow-card),
+    inset 0 1px 0 rgba(255, 255, 255, 0.88);
+}
+
+.card {
+  border-radius: 22px;
+  min-height: 92px;
+}
+
+.card span,
+.subline,
+.description,
+.metaLine {
+  color: #5f6f85;
+}
+
+.clickableCard:hover,
+.kanbanCard:hover,
+.performanceGauge:hover {
+  border-color: rgba(147, 197, 253, 0.86);
+  box-shadow: var(--shadow-hover);
+  transform: translateY(-2px);
+}
+
+.kanbanColumn {
+  background: linear-gradient(180deg, rgba(248, 251, 255, 0.96), rgba(241, 245, 249, 0.86));
+  border-radius: 22px;
+}
+
+.kanbanCard,
+.calendarTask,
+.dayTask,
+.timeEntry,
+.commentItem,
+.heroDetailGrid article,
+.heroDescription,
+.workloadCell,
+.workloadUser {
+  border-color: rgba(203, 213, 225, 0.7);
+  box-shadow:
+    0 8px 22px rgba(15, 23, 42, 0.045),
+    inset 0 1px 0 rgba(255, 255, 255, 0.82);
+}
+
+.tableCard {
+  border-radius: 24px;
+  overflow: hidden;
+}
+
+.table {
+  background: rgba(255, 255, 255, 0.9);
+}
+
+.table th {
+  background: rgba(248, 250, 252, 0.86);
+  color: #334155;
+  font-size: 0.8rem;
+  letter-spacing: 0.01em;
+}
+
+.table td {
+  border-top-color: rgba(226, 232, 240, 0.72);
+}
+
+.table th:not(:last-child),
+.table td:not(:last-child) {
+  border-right: 1px solid rgba(203, 213, 225, 0.74);
+}
+
+.clickableRow {
+  transition: background 0.18s ease, box-shadow 0.18s ease;
+}
+
+.clickableRow:hover {
+  background: rgba(239, 246, 255, 0.68);
+}
+
+.badge,
+.remainingTime,
+.deadlinePill,
+.archiveCountdown,
+.absenceChip,
+.performanceBadge {
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.62);
+}
+
+.filterBar input,
+.filterBar select,
+.kanbanActions select,
+.table select,
+.settingsCard select,
+.userForm input,
+.userForm select,
+.teamForm input,
+.escalationForm input,
+.escalationForm select,
+.modal input,
+.modal select,
+.modal textarea,
+.heroSearchBar input {
+  background: rgba(255, 255, 255, 0.86);
+  border-color: rgba(148, 163, 184, 0.42);
+  border-radius: 14px;
+  box-shadow:
+    inset 0 1px 2px rgba(15, 23, 42, 0.04),
+    0 1px 0 rgba(255, 255, 255, 0.86);
+  outline: none;
+  transition: border-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
+}
+
+.filterBar input:focus,
+.filterBar select:focus,
+.kanbanActions select:focus,
+.table select:focus,
+.settingsCard select:focus,
+.userForm input:focus,
+.userForm select:focus,
+.teamForm input:focus,
+.escalationForm input:focus,
+.escalationForm select:focus,
+.modal input:focus,
+.modal select:focus,
+.modal textarea:focus,
+.heroSearchBar input:focus {
+  background: #ffffff;
+  border-color: #60a5fa;
+  box-shadow:
+    0 0 0 4px rgba(96, 165, 250, 0.18),
+    inset 0 1px 2px rgba(15, 23, 42, 0.04);
+}
+
+.overlay {
+  background: rgba(15, 23, 42, 0.42);
+  backdrop-filter: blur(14px) saturate(1.05);
+}
+
+.stackedModalOverlay {
+  background: rgba(15, 23, 42, 0.24);
+  z-index: 180;
+}
+
+.modal {
+  background:
+    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96));
+  border: 1px solid rgba(255, 255, 255, 0.74);
+  border-radius: 30px;
+  box-shadow:
+    0 34px 90px rgba(15, 23, 42, 0.28),
+    inset 0 1px 0 rgba(255, 255, 255, 0.9);
+}
+
+.modal h2 {
+  font-size: 1.65rem;
+  letter-spacing: -0.02em;
+}
+
+.notificationBell,
+.userMenuButton {
+  background: rgba(239, 246, 255, 0.88);
+  border-color: rgba(191, 219, 254, 0.9);
+  box-shadow:
+    0 10px 24px rgba(37, 99, 235, 0.12),
+    inset 0 1px 0 rgba(255, 255, 255, 0.9);
+}
+
+.notificationBell:hover,
+.userMenuButton:hover {
+  background: #ffffff;
+  transform: translateY(-1px);
+}
+
+.notificationBell.notificationBellActive {
+  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
+  border-color: rgba(255, 255, 255, 0.28);
+  color: #ffffff;
+  box-shadow:
+    0 14px 30px rgba(37, 99, 235, 0.24),
+    inset 0 1px 0 rgba(255, 255, 255, 0.32);
+}
+
+.notificationPanel,
+.userMenuPanel {
+  border-color: rgba(203, 213, 225, 0.72);
+  box-shadow:
+    0 28px 70px rgba(15, 23, 42, 0.18),
+    inset 0 1px 0 rgba(255, 255, 255, 0.86);
+}
+
+.calendarDay {
+  background: rgba(255, 255, 255, 0.72);
+}
+
+.calendarDay:hover {
+  background: #ffffff;
+}
+
+.workloadDayHeader[data-weekday="true"],
+.workloadCell[data-weekday="true"] {
+  background: rgba(239, 246, 255, 0.72);
+}
+
+.workloadDayHeader[data-holiday="true"] {
+  background: #dbeafe;
+  border-color: #93c5fd;
+  color: #1d4ed8;
+}
+
+.overviewPanel {
+  display: grid;
+  gap: 20px;
+}
+
+.overviewHero {
+  align-items: stretch;
+  background: #ffffff;
+  border: 1px solid #dbe3ee;
+  border-radius: 20px;
+  display: grid;
+  gap: 24px;
+  grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
+  padding: 30px;
+  box-shadow: 0 16px 38px rgba(15, 23, 42, 0.07);
+}
+
+.overviewHero h1 {
+  color: #0f172a;
+  font-size: 2.45rem;
+  line-height: 1.05;
+  margin: 0;
+  max-width: 760px;
+}
+
+.overviewHero p {
+  color: #526173;
+  font-size: 1rem;
+  font-weight: 650;
+  line-height: 1.55;
+  margin: 16px 0 0;
+  max-width: 820px;
+}
+
+.overviewHeroStats {
+  display: grid;
+  gap: 10px;
+}
+
+.overviewHeroStats article {
+  background: #f8fafc;
+  border: 1px solid #e2e8f0;
+  border-radius: 14px;
+  padding: 16px;
+}
+
+.overviewHeroStats span,
+.overviewHeroStats strong {
+  display: block;
+}
+
+.overviewHeroStats span {
+  color: #64748b;
+  font-size: 0.82rem;
+  font-weight: 850;
+}
+
+.overviewHeroStats strong {
+  color: #0f172a;
+  font-size: 2rem;
+  margin-top: 4px;
+}
+
+.moduleGrid {
+  display: grid;
+  gap: 18px;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.moduleCard {
+  background: #ffffff;
+  border: 1px solid #dbe3ee;
+  border-radius: 18px;
+  display: flex;
+  flex-direction: column;
+  min-height: 242px;
+  padding: 22px;
+  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
+}
+
+.moduleCard[data-tone="blue"] {
+  border-top: 4px solid #2563eb;
+}
+
+.moduleCard[data-tone="teal"] {
+  border-top: 4px solid #009ca6;
+}
+
+.moduleCard[data-tone="amber"] {
+  border-top: 4px solid #f59e0b;
+}
+
+.moduleCard[data-tone="rose"] {
+  border-top: 4px solid #f43f5e;
+}
+
+.moduleCard[data-tone="slate"] {
+  border-top: 4px solid #475569;
+}
+
+.moduleCardTop {
+  align-items: center;
+  display: flex;
+  justify-content: space-between;
+  gap: 14px;
+}
+
+.moduleCardTop span {
+  color: #64748b;
+  font-size: 0.78rem;
+  font-weight: 900;
+  text-transform: uppercase;
+}
+
+.moduleCardTop strong {
+  align-items: center;
+  background: #f1f5f9;
+  border-radius: 999px;
+  color: #0f172a;
+  display: inline-flex;
+  font-size: 1.25rem;
+  min-height: 42px;
+  min-width: 42px;
+  justify-content: center;
+  padding: 0 12px;
+}
+
+.moduleCard h2 {
+  color: #0f172a;
+  font-size: 1.35rem;
+  margin: 24px 0 0;
+}
+
+.moduleCard p {
+  color: #526173;
+  font-size: 0.94rem;
+  font-weight: 650;
+  line-height: 1.5;
+  margin: 10px 0 22px;
+}
+
+.moduleAction {
+  align-self: flex-start;
+  background: #eef2f6;
+  border: 1px solid #d8e0ea;
+  border-radius: 12px;
+  color: #0f172a;
+  cursor: pointer;
+  font-family: inherit;
+  font-weight: 900;
+  margin-top: auto;
+  padding: 10px 14px;
+}
+
+.moduleAction:hover {
+  background: #ffffff;
+  border-color: #94a3b8;
+}
+
+.nextBuildPanel,
+.plannedModule {
+  align-items: center;
+  background: #0f172a;
+  border-radius: 20px;
+  color: #ffffff;
+  display: flex;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 24px;
+}
+
+.nextBuildPanel h2,
+.plannedModule h1 {
+  margin: 0;
+}
+
+.nextBuildPanel p,
+.plannedModule p {
+  color: #cbd5e1;
+  font-weight: 650;
+  line-height: 1.5;
+  margin: 10px 0 0;
+  max-width: 760px;
+}
+
+.plannedModule {
+  align-items: stretch;
+  flex-direction: column;
+}
+
+.plannedModuleGrid {
+  display: grid;
+  gap: 12px;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.plannedModuleGrid article {
+  background: rgba(255, 255, 255, 0.08);
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-radius: 14px;
+  padding: 16px;
+}
+
+.plannedModuleGrid strong,
+.plannedModuleGrid span {
+  display: block;
+}
+
+.plannedModuleGrid span {
+  color: #cbd5e1;
+  font-size: 0.9rem;
+  font-weight: 650;
+  line-height: 1.45;
+  margin-top: 8px;
+}
+
+.tabs .activeTab,
+.tabs .activeTab:hover {
+  background: #153f43;
+  border-color: rgba(45, 212, 191, 0.3);
+  color: #ffffff;
+  box-shadow: inset 4px 0 0 #2dd4bf;
+}
+
+@media (max-width: 900px) {
+  .shell {
+    border-radius: 0;
+    grid-template-columns: 1fr;
+    padding: 0;
+  }
+
+  .header {
+    grid-template-columns: 1fr;
+    position: static;
+  }
+
+  .headerActions {
+    justify-content: flex-start;
+  }
+
+  .tabs,
+  .content {
+    grid-column: 1;
+  }
+
+  .tabs {
+    flex-direction: row;
+    flex-wrap: nowrap;
+    overflow-x: auto;
+    padding: 10px;
+  }
+
+  .tab {
+    flex: 0 0 auto;
+    white-space: nowrap;
+  }
+
+  .loginLayout {
+    grid-template-columns: 1fr;
+    max-width: 680px;
+  }
+
+  .loginHero {
+    min-height: 280px;
+    padding: 38px 28px 18px;
+  }
+
+  .loginPanel {
+    padding: 24px 24px 86px;
+  }
+
+  .creatorBadge {
+    bottom: auto;
+  }
+
+  .loginHero,
+  .loginLayout {
+    min-height: auto;
+  }
+
+  .loginShell {
+    background: #eef2f6;
+    overflow: auto;
+    padding: 18px;
+  }
+
+  .loginLogo {
+    max-width: 280px;
+  }
+
+  .loginHero h2 {
+    font-size: 2.65rem;
+  }
+
+  .loginPreviewStack {
+    grid-template-columns: 1fr;
+    grid-template-rows: none;
+    margin-top: 28px;
+  }
+
+  .loginMiniCard,
+  .loginProgressCard,
+  .loginTaskCard,
+  .loginListCard {
+    grid-column: auto;
+    grid-row: auto;
+  }
+
+  .loginTaskCard {
+    display: none;
+  }
+
+  .tabs {
+    flex-wrap: wrap;
+  }
+
+  .topline {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .toplineActions {
+    align-items: stretch;
+    flex-direction: column;
+    width: 100%;
+  }
+
+  .cards {
+    grid-template-columns: repeat(2, 1fr);
+  }
+
+  .overviewHero,
+  .moduleGrid,
+  .plannedModuleGrid {
+    grid-template-columns: 1fr;
+  }
+
+  .nextBuildPanel {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .filterBar {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .kanbanBoard {
+    grid-template-columns: repeat(5, 240px);
+  }
+
+  .kanbanActions {
+    align-items: stretch;
+    flex-direction: column;
+    width: 100%;
+  }
+
+  .kanbanActions select {
+    width: 100%;
+  }
+
+  .calendarGrid {
+    grid-template-columns: repeat(7, 180px);
+    overflow-x: auto;
+  }
+
+  .calendarToolbar {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .absenceForm {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .absenceForm button {
+    grid-column: 1 / -1;
+  }
+
+  .weekGrid {
+    grid-template-columns: repeat(7, 220px);
+  }
+
+  .dayTask {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .formGrid {
+    grid-template-columns: 1fr;
+  }
+
+  .contentDateTimeRow {
+    grid-template-columns: 1fr;
+  }
+
+  .timeForm {
+    grid-template-columns: 1fr;
+  }
+
+  .timeEntry {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .modalFooter {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .createdAtHint {
+    text-align: left;
+  }
+
+  .settingsGrid {
+    grid-template-columns: 1fr;
+  }
+
+  .settingsHeader {
+    flex-direction: column;
+  }
+
+  .userForm {
+    grid-template-columns: 1fr;
+  }
+
+  .teamForm {
+    grid-template-columns: 1fr;
+  }
+
+  .escalationForm {
+    grid-template-columns: 1fr;
+  }
+
+  .actionGroup {
+    flex-direction: column;
+  }
+
+  .tableCard {
+    overflow-x: auto;
+  }
+}
+
+.contactsPanel {
+  display: grid;
+  gap: 18px;
+}
+
+.contactSummaryGrid {
+  display: grid;
+  gap: 12px;
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+}
+
+.contactSummaryCard {
+  background: #ffffff;
+  border: 1px solid var(--border-subtle);
+  border-radius: 16px;
+  cursor: pointer;
+  display: grid;
+  gap: 8px;
+  min-height: 92px;
+  padding: 15px;
+  text-align: left;
+}
+
+.contactSummaryCard:hover,
+.contactSummaryCard[data-active="true"] {
+  border-color: #67d7de;
+  box-shadow: 0 12px 28px rgba(0, 156, 166, 0.12);
+}
+
+.contactSummaryCard[data-active="true"] {
+  background: #f0fdfd;
+}
+
+.contactSummaryCard span {
+  color: #64748b;
+  font-size: 0.8rem;
+  font-weight: 900;
+}
+
+.contactSummaryCard strong {
+  color: var(--ink);
+  font-size: 1.75rem;
+  line-height: 1;
+}
+
+.contactToolbar {
