+  font-weight: 500;
+  min-height: 38px;
+  padding: 8px 12px;
+  width: 100%;
+}
+
+.contactToolbarActions {
+  align-items: flex-end;
+  display: flex;
+  gap: 8px;
+  justify-content: flex-end;
+}
+
+.contactColumnPicker {
