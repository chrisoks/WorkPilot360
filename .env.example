DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tasks"
WORKPILOT_SESSION_SECRET=""
# Eigener HMAC-Schlüssel (mindestens 32 Zeichen) für öffentliche Online-Anfragen.
ONLINE_REQUEST_SIGNING_SECRET=""
# Optionaler Cloudflare-Turnstile-Server-Schlüssel. Nur zusammen mit einem
# im OnlineRequestPortal gespeicherten Site-Key aktivieren.
ONLINE_REQUEST_TURNSTILE_SECRET=""
# Portal-Setup (kommagetrennte Werte, optional):
ONLINE_REQUEST_ORGANIZATION_SLUG="demo"
ONLINE_REQUEST_PORTAL_SLUG="ok-immocare"
ONLINE_REQUEST_PORTAL_NAME="OK immocare"
ONLINE_REQUEST_TRUSTED_HOSTNAMES="workpilot360.oks-cloudservices.com"
ONLINE_REQUEST_NOTIFICATION_USER_IDS=""
ONLINE_REQUEST_TURNSTILE_SITE_KEY=""
WORKPILOT_TASK_ESCALATION_DELIVERY_ENABLED="false"
WORKPILOT_TASK_ESCALATION_AUTOMATION_ENABLED="false"
WORKPILOT_PROJECT_STATUS_DELIVERY_ENABLED="false"
WORKPILOT_PROJECT_STATUS_AUTOMATION_ENABLED="false"
HERO_GRAPHQL_ENDPOINT="https://login.hero-software.de/api/external/v7/graphql"
HERO_API_KEY="YOUR_HERO_API_KEY"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# JARVIS: Systemhilfe nutzt standardmäßig Luna; BWL und Vertrieb bleiben auf dem stärkeren Analysemodell.
OPENAI_API_KEY=""
OPENAI_JARVIS_MODEL="gpt-5.6-luna"
# Optional: separates the small intent classifier from the normal JARVIS model.
OPENAI_JARVIS_INTENT_MODEL=""
# Kill switch for the AI intent fallback. Known questions stay deterministic.
OPENAI_JARVIS_INTENT_ENABLED="true"
OPENAI_MANAGEMENT_MODEL="gpt-5.6-terra"
# Zentrale JARVIS-Modellrichtlinie: Sol bleibt eine ausdrückliche Ausnahme.
OPENAI_JARVIS_COMPLEX_MODEL="gpt-5.6-sol"
OPENAI_JARVIS_SOL_FAST_ENABLED="false"
OPENAI_JARVIS_INTENT_TIMEOUT_MS="4000"
OPENAI_MANAGEMENT_TIMEOUT_MS="18000"
OPENAI_JARVIS_INTENT_MAX_OUTPUT_TOKENS="180"
OPENAI_MANAGEMENT_MAX_OUTPUT_TOKENS="520"
MS365_TENANT_ID="common"
MS365_CLIENT_ID="YOUR_MICROSOFT_APP_CLIENT_ID"
MS365_CLIENT_SECRET="YOUR_MICROSOFT_APP_CLIENT_SECRET"
MS365_REDIRECT_URI="http://localhost:3001/api/mail/oauth/callback"
SYSTEM_MAIL_SMTP_HOST="smtp.strato.de"
SYSTEM_MAIL_SMTP_PORT="587"
SYSTEM_MAIL_SMTP_SECURE="false"
SYSTEM_MAIL_SMTP_USER="info@oks-cloudservices.com"
SYSTEM_MAIL_SMTP_PASSWORD="YOUR_STRATO_MAILBOX_PASSWORD"
SYSTEM_MAIL_FROM="WorkPilot360 Benachrichtigungen <info@oks-cloudservices.com>"
SYSTEM_MAIL_REPLY_TO=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@oks-cloudservices.com"
PUSH_REMINDER_CRON_SECRET=""
OKS_PHONE_PROVISION_ORGANIZATION_SLUG=""
OKS_PHONE_PROVISION_KEY_ID=""
OKS_PHONE_PROVISION_SECRET=""
OKS_PHONE_PROVISION_NAME="OKS Phone"
OKS_PHONE_PROVISION_SCOPES="customer-context:read,customer-logbook:write,project-logbook:write,contacts-delta:read"
OKS_PHONE_PROVISION_RATE_LIMIT="120"
KOSIT_JAVA_PATH="java"
KOSIT_VALIDATOR_JAR=""
KOSIT_VALIDATOR_REPOSITORY=""
KOSIT_VALIDATOR_SCENARIOS="scenarios.xml"
# Projektkarte: Server-Geocoding wird nur nach einem bewussten UI-Klick ausgeführt.
OPENCAGE_API_KEY=
OPENCAGE_REQUEST_INTERVAL_MS=1100
# Optionaler MapLibre-Stil. Ohne Angabe wird die OpenStreetMap-Rasterkarte verwendet.
NEXT_PUBLIC_PROJECT_MAP_STYLE_URL=
# Aktuelle Kraftstoffpreise der HERM-Tankstelle in Buchen.
# API-Key: https://creativecommons.tankerkoenig.de
TANKERKOENIG_API_KEY=
# Optional: feste Tankstellen-UUID. Ohne UUID wird die Adresse im 1,5-km-Umkreis gesucht.
TANKERKOENIG_STATION_ID=
TANKERKOENIG_STATION_LAT=49.526326
TANKERKOENIG_STATION_LNG=9.334996
