  dailyRentalRate           Float?
  includedKilometersPerDay  Float?
  extraKilometerPrice       Float?
  depositAmount             Float?
  fuelPolicy                String   @default("Voll/Voll")
  note                      String   @default("")
  isActive                  Boolean  @default(true)
  createdById               String?
  createdByName             String   @default("")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([organizationId, vehicleNumber])
  @@index([organizationId, isActive, name])
}

model VehicleCalculation {
  id                 String    @id @default(cuid())
  organizationId     String
  vehicleId          String
  vehicleNumber      String
  vehicleName        String
  customerId         String    @default("")
  projectId          String    @default("")
  createdById        String?
  createdByName      String    @default("")
  inputSnapshot      Json
  resultSnapshot     Json
  fuelPriceSource    String    @default("")
  fuelPriceFetchedAt DateTime?
  note               String    @default("")
  createdAt          DateTime  @default(now())

  @@index([organizationId, vehicleId, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, createdAt])
}

model WinterServiceRun {
  id                String    @id
  organizationId    String
  projectId         String
  projectNumber     String    @default("")
  projectTitle      String    @default("")
  customerName      String    @default("")
  contactId         String    @default("")
  contactPersonId   String    @default("")
  serviceDate       String
  month             String
  serviceType       String    @default("")
  status            String    @default("offen")
  beforeImages      Json      @default("[]")
  afterImages       Json      @default("[]")
  reportStatus      String    @default("offen")
  reportNumber      String    @default("")
  reportPdfData     String?   @db.Text
  reportGeneratedAt DateTime?
  sentStatus        String    @default("offen")
  sentAt            DateTime?
  sentTo            String    @default("")
  invoiceId         String    @default("")
  invoiceNumber     String    @default("")
  invoiceLineId     String    @default("")
  billingAction     String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now())

  @@index([organizationId, month])
  @@index([organizationId, projectId])
}

model WinterServiceAutomationSetting {
  id                  String   @id
  organizationId      String   @unique
  enabled             Boolean  @default(false)
  senderUserId        String   @default("")
  notificationUserIds Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())
}

