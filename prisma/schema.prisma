generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  locale                        String                         @default("de")
  timezone                      String                         @default("Europe/Berlin")
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  auditLogs                     AuditLog[]
  businessAreas                 BusinessArea[]
  businessAreaTargets           BusinessAreaTarget[]
  monthlyFinancialReportValues  MonthlyFinancialReportValue[]
  categories                    Category[]
  departments                   Department[]
  escalationRules               EscalationRule[]
  organizationSettings          OrganizationSetting[]
  checklistTemplates            ChecklistTemplate[]
  checklistTemplateVersions     ChecklistTemplateVersion[]
  notifications                 Notification[]
  onlineRequestAuditEvents      OnlineRequestAuditEvent[]
  onlineRequestPhotos           OnlineRequestPhoto[]
  onlineRequestPortals          OnlineRequestPortal[]
  onlineRequestPublicSessions   OnlineRequestPublicSession[]
  onlineRequestRateLimitBuckets OnlineRequestRateLimitBucket[]
  onlineRequests                OnlineRequest[]
  storedFiles                   StoredFile[]
  catalogItems                  CatalogItem[]
  catalogItemHistory            CatalogItemHistory[]
  catalogInventoryMovements     CatalogInventoryMovement[]
  unitOptions                   UnitOption[]
  catalogPackageItems           CatalogPackageItem[]
  contentApprovalHistory        ContentApprovalHistory[]
  contentItems                  ContentItem[]
  offers                        Offer[]
  offerLines                    OfferLine[]
  offerLineLabor                OfferLineLabor[]
  offerHistory                  OfferHistory[]
  planningGroupCapacitySettings PlanningGroupCapacitySetting[]
  invoices                      Invoice[]
  invoiceLines                  InvoiceLine[]
  invoiceLineLabor              InvoiceLineLabor[]
  invoiceHistory                InvoiceHistory[]
  jarvisActionDrafts            JarvisActionDraft[]
  jarvisActionDraftAuditEvents  JarvisActionDraftAuditEvent[]
  employeeCostCalculations      EmployeeCostCalculation[]
  employeeDocuments             EmployeeDocument[]
  recurringRules                RecurringTaskRule[]
  subcategories                 Subcategory[]
  tasks                         Task[]
  taskComments                  TaskComment[]
  taskLinks                     TaskLink[]
  taskParticipants              TaskParticipant[]
  taskTemplates                 TaskTemplate[]
  taskEscalationEpisodes        TaskEscalationEpisode[]
  teams                         Team[]
  timeEntries                   TimeEntry[]
  users                         User[]
}

model User {
  id                      String                    @id @default(cuid())
  organizationId          String
  email                   String
  passwordHash            String
  firstName               String
  lastName                String
  role                    Role
  isActive                Boolean                   @default(true)
  teamId                  String?
  departmentId            String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  dailyWorkHours          Float                     @default(8)
  profileImageDataUrl     String?
  personalNumber          String?
  salutation              String?
  birthDate               DateTime?
  language                String?
  phone                   String?
  mobile                  String?
  street                  String?
  postalCode              String?
  city                    String?
  signature               String?
  signatureHidden         Boolean?                  @default(false)
  planningBoard           String?
  planningGroup           String?
  weeklyCapacity          Json                      @default("{\"monday\":8,\"tuesday\":8,\"wednesday\":8,\"thursday\":8,\"friday\":8,\"saturday\":0,\"sunday\":0}")
  planningStartTime       String                    @default("08:00")
  planningEndTime         String                    @default("17:00")
  planningTimeWindows     Json                      @default("{\"monday\":{\"start\":\"08:00\",\"end\":\"17:00\"},\"tuesday\":{\"start\":\"08:00\",\"end\":\"17:00\"},\"wednesday\":{\"start\":\"08:00\",\"end\":\"17:00\"},\"thursday\":{\"start\":\"08:00\",\"end\":\"17:00\"},\"friday\":{\"start\":\"08:00\",\"end\":\"17:00\"},\"saturday\":{\"start\":\"08:00\",\"end\":\"17:00\"},\"sunday\":{\"start\":\"08:00\",\"end\":\"17:00\"}}")
  planningBreakWindows    Json                      @default("{\"monday\":{\"start\":\"12:00\",\"end\":\"12:30\"},\"tuesday\":{\"start\":\"12:00\",\"end\":\"12:30\"},\"wednesday\":{\"start\":\"12:00\",\"end\":\"12:30\"},\"thursday\":{\"start\":\"12:00\",\"end\":\"12:30\"},\"friday\":{\"start\":\"12:00\",\"end\":\"12:30\"},\"saturday\":{\"start\":\"\",\"end\":\"\"},\"sunday\":{\"start\":\"\",\"end\":\"\"}}")
  planningResponsibleFor  Json                      @default("[]")
  leadershipManagerId     String?
  leadershipDeputyId      String?
  branchAllocations       Json?
  includeInLaborCostRate  Boolean                   @default(true)
  sellableCapacityEnabled Boolean?                  @default(true)
  salesRoleEnabled        Boolean?                  @default(false)
  notifyIdeaStore         Boolean                   @default(true)
  notifyUpsell            Boolean                   @default(false)
  mailAccount             Json                      @default("{}")
  employeeAssessment      Json                      @default("{}")
  costCalculations        EmployeeCostCalculation[]
  notifications           Notification[]
  ownedTasks              Task[]                    @relation("TaskOwner")
  taskComments            TaskComment[]
  taskParticipations      TaskParticipant[]
  taskEscalationEpisodes  TaskEscalationEpisode[]
  timeEntries             TimeEntry[]
  department              Department?               @relation(fields: [departmentId], references: [id])
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team                    Team?                     @relation(fields: [teamId], references: [id])

  @@unique([organizationId, email])
  @@index([organizationId, leadershipManagerId])
  @@index([organizationId, leadershipDeputyId])
}

model EmployeeLeadershipHistory {
  id                String   @id @default(cuid())
  organizationId    String
  employeeId        String
  actorId           String?
  previousManagerId String?
  managerId         String?
  previousDeputyId  String?
  deputyId          String?
  createdAt         DateTime @default(now())

  @@index([organizationId, employeeId, createdAt])
}

model AuthSession {
  id                   String    @id
  userId               String
  tokenVersion         Int       @default(1)
  previousTokenVersion Int?
  previousValidUntil   DateTime?
  createdAt            DateTime  @default(now())
  lastSeenAt           DateTime  @default(now())
  lastRotatedAt        DateTime  @default(now())
  idleExpiresAt        DateTime
  absoluteExpiresAt    DateTime
  revokedAt            DateTime?

  @@index([userId])
  @@index([absoluteExpiresAt])
}

model EmployeeCostCalculation {
  id              String       @id @default(cuid())
  organizationId  String
  userId          String
  monthlySalary   Float        @default(0)
  fullCostFactor  Float        @default(1.35)
  annualHours     Float        @default(2080)
  vacationDays    Float        @default(30)
  trainingDays    Float        @default(0)
  sickDays        Float        @default(10)
  hoursPerDay     Float        @default(8)
  updatedByUserId String?
  updatedByName   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, userId])
}

model EmployeeDocument {
  id               String       @id @default(cuid())
  organizationId   String
  employeeId       String
  category         String
  originalFileName String
  mimeType         String
  size             Int
  fileData         Bytes
  uploadedById     String
  uploadedByName   String
  createdAt        DateTime     @default(now())
  deletedAt        DateTime?
  deletedById      String?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId, category, createdAt])
  @@index([organizationId, deletedAt])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams          Team[]
  users          User[]
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  tasks          Task[]
  department     Department?  @relation(fields: [departmentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
}

model Task {
  id                      String                  @id @default(cuid())
  organizationId          String
  title                   String
  description             String
  status                  TaskStatus              @default(OFFEN)
  priority                TaskPriority            @default(NORMAL)
  deadline                DateTime
  customer                String?
  customerClass           CustomerClassification?
  projectId               String?
  categoryId              String?
  subcategoryId           String?
  estimateMinutes         Int?
  ownerId                 String
  teamId                  String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  autoFeedbackEnabled     Boolean                 @default(false)
  autoFeedbackRecipientId String?
  recurrenceEnabled       Boolean                 @default(false)
  recurrenceInterval      String?
  recurrenceParentTaskId  String?
  createdById             String?
  acceptanceStatus        String                  @default("accepted")
  acceptanceRespondedAt   DateTime?
  rejectionReason         String?
  completedAt             DateTime?
  archiveDueAt            DateTime?
  archivedAt              DateTime?
  archiveReason           String?
  planningAllocations     Json                    @default("[]")
  history                 Json                    @default("[]")
  auditLogs               AuditLog[]
  notifications           Notification[]
  category                Category?               @relation(fields: [categoryId], references: [id])
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner                   User                    @relation("TaskOwner", fields: [ownerId], references: [id])
  subcategory             Subcategory?            @relation(fields: [subcategoryId], references: [id])
  team                    Team?                   @relation(fields: [teamId], references: [id])
  comments                TaskComment[]
  links                   TaskLink[]
  participants            TaskParticipant[]
  timeEntries             TimeEntry[]

  @@index([organizationId, projectId])
}

model TaskParticipant {
  id                    String       @id @default(cuid())
  organizationId        String
  taskId                String
  userId                String
  acceptanceStatus      String       @default("pending")
  acceptanceRespondedAt DateTime?
  rejectionReason       String?
  createdAt             DateTime     @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task                  Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskComment {
  id              String       @id @default(cuid())
  organizationId  String
  taskId          String
  authorId        String
  recipientUserId String?
  body            String
  createdAt       DateTime     @default(now())
  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TimeEntry {
  id              String       @id @default(cuid())
  organizationId  String
  taskId          String
  userId          String
  startedAt       DateTime
  stoppedAt       DateTime?
  durationMinutes Int          @default(0)
  note            String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskLink {
  id             String       @id @default(cuid())
  organizationId String
  taskId         String
  label          String
  url            String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Category {
  id             String        @id @default(cuid())
  organizationId String
  businessAreaId String?
  name           String
  projectPrefix  String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessArea   BusinessArea? @relation(fields: [businessAreaId], references: [id], onDelete: SetNull)
  subcategories  Subcategory[]
  tasks          Task[]

  @@index([organizationId, businessAreaId])
}

model BusinessArea {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories     Category[]
  targets        BusinessAreaTarget[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model BusinessAreaTarget {
  id             String       @id @default(cuid())
  organizationId String
  businessAreaId String
  month          String
  amount         Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessArea   BusinessArea @relation(fields: [businessAreaId], references: [id], onDelete: Cascade)

  @@unique([organizationId, businessAreaId, month])
  @@index([organizationId, month])
}

model PlanningGroupCapacitySetting {
  id                       String       @id
  organizationId           String
  planningBoard            String
  planningGroup            String
  manualSvsPerHour         Float?
  manualOverridesAutomatic Boolean      @default(false)
  automaticOverridesManual Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @default(now())
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, planningBoard, planningGroup], map: "PlanningGroupCapacitySetting_org_board_group_key")
}

model Subcategory {
  id             String       @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  taskId         String?
  channel        String
  subject        String
  body           String
  linkTarget     String?
  linkTargetId   String?
  linkLabel      String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  resolvedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task?        @relation(fields: [taskId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id             String   @id
  organizationId String
  userId         String
  endpoint       String
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, endpoint], map: "PushSubscription_user_endpoint_key")
  @@index([organizationId, userId])
}

model UnbilledTimeAlert {
  id             String    @id
  organizationId String
  alertKey       String
  projectId      String
  periodKey      String
  stage          String
  notificationId String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@unique([organizationId, alertKey, stage], map: "UnbilledTimeAlert_org_alert_stage_key")
  @@index([organizationId, projectId])
}

model ProjectEndPhaseReminder {
  id             String   @id
  organizationId String
  projectId      String
  notificationId String?
  sentAt         DateTime @default(now())

  @@index([organizationId, projectId, sentAt], map: "ProjectEndPhaseReminder_org_project_sent_idx")
}

model ProjectPotentialDecisionReminder {
  id             String   @id
  organizationId String
  potentialId    String
  level          String
  notificationId String?
  sentAt         DateTime @default(now())

  @@unique([organizationId, potentialId, level], map: "ProjectPotentialDecisionReminder_org_potential_level")
}

model NewsPost {
  id                String   @id
  organizationId    String
  title             String
  body              String   @default("")
  authorUserId      String?
  authorName        String   @default("")
  visibility        String   @default("all")
  departmentIds     Json     @default("[]")
  teamIds           Json     @default("[]")
  userIds           Json     @default("[]")
  attachments       Json     @default("[]")
  pollQuestion      String   @default("")
  pollOptions       Json     @default("[]")
  pollAllowMultiple Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([organizationId, createdAt])
}

model NewsPollVote {
  organizationId String
  postId         String
  optionId       String
  userId         String
  createdAt      DateTime @default(now())

  @@id([postId, optionId, userId])
  @@index([organizationId, postId])
  @@index([organizationId, userId])
}

model NewsComment {
  id             String   @id
  organizationId String
  postId         String
  body           String
  authorUserId   String?
  authorName     String   @default("")
  createdAt      DateTime @default(now())

  @@index([organizationId, postId])
}

model NewsReaction {
  organizationId String
  postId         String
  userId         String
  reaction       String   @default("up")
  createdAt      DateTime @default(now())

  @@id([postId, userId])
  @@index([organizationId, postId])
}

model NewsReadState {
  organizationId String
  postId         String
  userId         String
  readAt         DateTime @default(now())

  @@id([postId, userId])
  @@index([organizationId, userId])
}

model SalesOpportunity {
  id             String    @id
  organizationId String
  title          String
  customerName   String    @default("")
  contactId      String?
  projectId      String?
  offerId        String?
  ownerUserId    String?
  ownerName      String    @default("")
  stage          String    @default("lead")
  estimatedValue Float     @default(0)
  probability    Int       @default(0)
  nextAction     String    @default("")
  nextActionAt   DateTime?
  source         String    @default("")
  notes          String    @default("")
  history        Json      @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@index([organizationId, stage])
  @@index([organizationId, ownerUserId])
}

model SalesActivity {
  id             String   @id
  organizationId String
  opportunityId  String
  type           String   @default("note")
  body           String
  actorUserId    String?
  actorName      String   @default("")
  createdAt      DateTime @default(now())

  @@index([organizationId, opportunityId])
}

model SalesTarget {
  id             String    @id
  organizationId String
  contactId      String?
  projectId      String?
  customerName   String    @default("")
  projectLabel   String    @default("")
  title          String
  description    String    @default("")
  ownerUserId    String?
  ownerName      String    @default("")
  priority       String    @default("normal")
  metricKey      String    @default("")
  targetValue    Float     @default(0)
  periodStart    String    @default("")
  periodEnd      String    @default("")
  targetMonth    String    @default("")
  followUpAt     DateTime?
  status         String    @default("open")
  history        Json      @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@index([organizationId, status])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, followUpAt])
}

model CustomerFeedbackRequest {
  id             String    @id
  organizationId String
  token          String    @unique
  invoiceId      String?
  invoiceNumber  String    @default("")
  projectId      String?
  contactId      String?
  customerName   String    @default("")
  recipientEmail String    @default("")
  salesUserId    String?
  salesUserName  String    @default("")
  status         String    @default("open")
  sentAt         DateTime?
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@index([organizationId, invoiceId])
  @@index([organizationId, status])
}

model CustomerFeedback {
  id             String   @id
  organizationId String
  requestId      String?
  invoiceId      String?
  invoiceNumber  String   @default("")
  projectId      String?
  contactId      String?
  customerName   String   @default("")
  rating         Int
  comment        String   @default("")
  wantsContact   Boolean  @default(false)
  source         String   @default("manual")
  salesUserId    String?
  salesUserName  String   @default("")
  hotAlert       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([organizationId, requestId])
  @@index([organizationId, rating])
  @@index([organizationId, hotAlert])
  @@index([organizationId, createdAt])
}

model CatalogItem {
  id                                String                     @id @default(cuid())
  organizationId                    String
  type                              String                     @default("article")
  number                            String
  name                              String
  category                          String?
  trade                             String                     @default("")
  unit                              String                     @default("Stk")
  description                       String?
  matchcode                         String?
  ean                               String?
  costCenter                        String?
  supplierName                      String?
  supplierNumber                    String?
  manufacturer                      String?
  manufacturerNumber                String?
  manufacturerTypeName              String?
  minimumOrderQuantity              Float?
  quantityScale                     String?
  priceUnit                         String?
  deliveryTime                      String?
  stockQuantity                     Float?
  purchasePrice                     Float                      @default(0)
  laborCostRateKey                  String                     @default("")
  listPrice                         Float                      @default(0)
  salesPrice                        Float                      @default(0)
  salesPriceCalculationMode         String                     @default("manual")
  salesRatePerHour                  Float?
  scheduledSalesPrice               Float?
  scheduledSalesRatePerHour         Float?
  scheduledSalesPriceValidFrom      DateTime?
  scheduledSalesPriceCreatedAt      DateTime?
  scheduledSalesPriceUpdatePackages Boolean                    @default(false)
  lastSalesPriceChangedAt           DateTime?
  lastSalesPriceOldValue            Float?
  lastSalesPriceNewValue            Float?
  vatRate                           Float                      @default(19)
  isLaborPosition                   Boolean                    @default(false)
  isPlanningRelevant                Boolean                    @default(false)
  planningMinutesPerUnit            Int                        @default(0)
  defaultPlanningBoard              String?
  defaultPlanningGroup              String?
  reviewStatus                      String                     @default("unreviewed")
  reviewedAt                        DateTime?
  reviewedByUserId                  String?
  reviewedByName                    String?
  reviewNote                        String?
  isActive                          Boolean                    @default(true)
  usedCount                         Int                        @default(0)
  createdAt                         DateTime                   @default(now())
  updatedAt                         DateTime                   @updatedAt
  organization                      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  history                           CatalogItemHistory[]
  inventoryMovements                CatalogInventoryMovement[]
  packageItems                      CatalogPackageItem[]       @relation("CatalogPackage")
  usedInPackages                    CatalogPackageItem[]       @relation("CatalogPackageComponent")

  @@unique([organizationId, number])
  @@index([organizationId, type])
  @@index([organizationId, isActive])
  @@index([organizationId, reviewStatus])
}

model CatalogPackageItem {
  id                      String       @id @default(cuid())
  organizationId          String
  packageId               String
  componentItemId         String
  quantity                Float        @default(1)
  position                Int          @default(0)
  descriptionOverride     String?
  priceOverride           Float?
  purchasePriceSnapshot   Float?
  salesPriceSnapshot      Float?
  planningMinutesOverride Int?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package                 CatalogItem  @relation("CatalogPackage", fields: [packageId], references: [id], onDelete: Cascade)
  componentItem           CatalogItem  @relation("CatalogPackageComponent", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@index([organizationId, packageId])
  @@index([organizationId, componentItemId])
}

model CatalogItemHistory {
  id             String       @id @default(cuid())
  organizationId String
  catalogItemId  String
  eventType      String
  fieldName      String?
  oldValue       String?
  newValue       String?
  actorUserId    String?
  actorName      String?
  note           String?
  createdAt      DateTime     @default(now())
  catalogItem    CatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, catalogItemId])
  @@index([organizationId, createdAt])
}

model CatalogInventoryMovement {
  id              String       @id @default(cuid())
  organizationId  String
  catalogItemId   String
  movementType    String
  quantityDelta   Float
  unitCost        Float?
  occurredAt      DateTime
  referenceType   String       @default("")
  referenceId     String       @default("")
  referenceNumber String       @default("")
  customerId      String       @default("")
  customerName    String       @default("")
  projectId       String       @default("")
  projectNumber   String       @default("")
  invoiceId       String       @default("")
  invoiceNumber   String       @default("")
  actorUserId     String?
  actorName       String       @default("")
  supplierName    String       @default("")
  note            String       @default("")
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItem     CatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([organizationId, catalogItemId, occurredAt])
  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, referenceType, referenceId])
  @@index([organizationId, invoiceId])
}

model UnitOption {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
