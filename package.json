{
  "name": "tasks-saas-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/start-next-dev.js",
    "prebuild": "node scripts/clean-next-build-cache.js",
    "build": "next build",
    "start": "next start",
    "check:mojibake": "node scripts/check-mojibake.js",
    "check:regressions": "node scripts/check-regressions.js",
    "check:session-secret": "node scripts/check-session-secret.js",
    "check:kosit": "node scripts/check-kosit-validator.js",
    "setup:kosit": "node scripts/setup-kosit-validator.js",
    "check:verapdf": "node scripts/check-verapdf-validator.js",
    "setup:verapdf": "node scripts/setup-verapdf-validator.js",
    "check:pdfa3-converter": "node scripts/check-pdfa3-converter.js",
    "setup:pdfa3-converter": "node scripts/setup-pdfa3-converter.js",
    "oks-phone:phones:dry-run": "node --env-file=.env scripts/normalize-contact-phones.mjs",
    "oks-phone:phones:apply": "node --env-file=.env scripts/normalize-contact-phones.mjs --apply",
    "oks-phone:legacy-duplicates:dry-run": "node --env-file=.env scripts/cleanup-imported-company-phone-duplicates.mjs",
    "oks-phone:legacy-duplicates:apply": "node --env-file=.env scripts/cleanup-imported-company-phone-duplicates.mjs --apply",
    "oks-phone:credential:provision": "node --env-file=.env scripts/provision-oks-phone-credential.mjs",
    "online-requests:configure": "node --env-file=.env scripts/configure-online-request-portal.mjs",
    "online-requests:configure:apply": "node --env-file=.env scripts/configure-online-request-portal.mjs --apply",
    "online-requests:qa": "node --env-file=.env scripts/qa-online-requests.mjs",
    "online-requests:qa:apply": "node --env-file=.env scripts/qa-online-requests.mjs --apply",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
